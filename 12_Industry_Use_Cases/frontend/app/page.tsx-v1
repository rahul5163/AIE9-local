"use client";

import { useState } from "react";

export default function Home() {

  const [messages, setMessages] = useState<
    { role: "user" | "agent"; content: string }[]
  >([]);

  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const [stage, setStage] = useState("");
  const [signals, setSignals] = useState<any>(null);
  const [showRaw, setShowRaw] = useState(false);

  function generateSignals(question: string) {

    const match = question.match(/ITEM_(\d+)/i);

    const seed = match ? parseInt(match[1]) : question.length;

    return {
      conversion: (1.5 + (seed % 3)).toFixed(1),
      visibility: 3000 + (seed % 2500),
      cannibalization: (0.4 + (seed % 3) * 0.1).toFixed(2)
    };

  }

  const handleSubmit = async () => {

    if (!input.trim()) return;

    const userMessage = { role: "user", content: input };

    setMessages([userMessage]);
    setSignals(null);
    setShowRaw(false);

    setLoading(true);

    try {

      setStage("🔎 Analyzing item signals...");
      await new Promise((r) => setTimeout(r, 600));

      setStage("📚 Retrieving merchandising knowledge...");
      await new Promise((r) => setTimeout(r, 600));

      setStage("🧠 Generating decision recommendations...");

      const res = await fetch("http://127.0.0.1:10000/query", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ question: input }),
      });

      const data = await res.json();

      setMessages([
        userMessage,
        { role: "agent", content: data.answer }
      ]);

      setSignals(generateSignals(input));

    } catch (err) {

      setMessages([
        userMessage,
        { role: "agent", content: "Error contacting backend." }
      ]);

    }

    setStage("");
    setLoading(false);

  };

  const latestAgentMessage =
    messages.filter((m) => m.role === "agent").slice(-1)[0];

  return (

    <main className="min-h-screen bg-gray-50 p-10">

      <div className="max-w-5xl mx-auto">

        <h1 className="text-4xl font-bold mb-2">
          Retail Decision Intelligence Agent
        </h1>

        <p className="text-gray-600 mb-2">
          Diagnose item performance and recommend merchandising interventions
        </p>

        <div className="text-sm text-gray-500 mb-8">
          Query → Signal Analysis → Knowledge Retrieval → Decision Engine
        </div>


        {/* Query */}

        <div className="bg-white rounded-xl shadow p-6 mb-8">

          <div className="flex gap-2 mb-3">

            <input
              className="flex-1 p-3 border rounded-lg"
              placeholder="Example: What can we do to improve ITEM_001 performance?"
              value={input}
              onChange={(e) => setInput(e.target.value)}
            />

            <button
              onClick={handleSubmit}
              className="px-5 py-2 bg-black text-white rounded-lg hover:bg-gray-800"
            >
              Analyze
            </button>

          </div>

          <div className="text-sm text-gray-500">
            Try: Diagnose ITEM_101 • Improve ITEM_205 • Suggest actions for ITEM_432
          </div>

        </div>


        {/* Reasoning */}

        {loading && (

          <div className="bg-blue-50 border border-blue-200 p-4 rounded-lg mb-8">

            <div className="font-semibold mb-2">
              Agent reasoning
            </div>

            <div className="animate-pulse text-sm">
              {stage}
            </div>

          </div>

        )}


        {/* Signals */}

        {signals && (

          <div className="bg-white shadow rounded-lg p-6 mb-8">

            <div className="border-b pb-2 mb-4 text-lg font-semibold">
              Item Performance Signals
            </div>

            <div className="grid grid-cols-3 gap-6 text-sm">

              <div>
                <div className="text-gray-500">Conversion</div>
                <div className="text-2xl font-bold text-red-500">
                  {signals.conversion}%
                </div>
                <div className="text-xs text-gray-500">
                  Below category benchmark
                </div>
              </div>

              <div>
                <div className="text-gray-500">Shelf Visibility</div>
                <div className="text-2xl font-bold text-yellow-600">
                  {signals.visibility}
                </div>
                <div className="text-xs text-gray-500">
                  Low impression volume
                </div>
              </div>

              <div>
                <div className="text-gray-500">Cannibalization</div>
                <div className="text-2xl font-bold text-gray-700">
                  {signals.cannibalization}
                </div>
                <div className="text-xs text-gray-500">
                  Potential category overlap
                </div>
              </div>

            </div>

          </div>

        )}


        {/* Diagnosis + Actions */}

        {latestAgentMessage && (

          <div className="grid grid-cols-2 gap-6 mb-8">

            <div className="bg-white shadow rounded-lg p-5">

              <div className="border-b pb-2 mb-4 font-semibold">
                🧠 Agent Diagnosis
              </div>

              <p className="text-sm text-gray-700">
                The system analyzed item signals and retrieved relevant
                merchandising interventions from the knowledge base.
              </p>

            </div>


            <div className="bg-white shadow rounded-lg p-5">

              <div className="border-b pb-2 mb-4 font-semibold">
                💡 Recommended Actions
              </div>


              <div className="bg-green-50 border border-green-200 rounded-md p-3 mb-4">

                <div className="font-semibold text-green-800">
                  Primary Action
                </div>

                <div className="text-sm text-green-700">
                  Increase item visibility and review merchandising placement.
                </div>

              </div>


              <button
                onClick={() => setShowRaw(!showRaw)}
                className="text-blue-600 text-sm underline mb-3"
              >
                {showRaw ? "Hide Diagnostic Report" : "Show Diagnostic Report"}
              </button>


              {showRaw && (

                <div className="bg-gray-100 border p-3 rounded text-xs whitespace-pre-wrap">
                  {latestAgentMessage.content}
                </div>

              )}

            </div>

          </div>

        )}


        {/* Capability cards */}

        <div className="grid grid-cols-3 gap-4 text-sm">

          <div className="bg-white p-4 rounded-lg shadow">

            <div className="font-semibold mb-1">
              📊 Analyze Signals
            </div>

            Detect drivers of item performance using retail metrics.

          </div>

          <div className="bg-white p-4 rounded-lg shadow">

            <div className="font-semibold mb-1">
              📚 Retrieve Knowledge
            </div>

            Search merchandising intervention knowledge base.

          </div>

          <div className="bg-white p-4 rounded-lg shadow">

            <div className="font-semibold mb-1">
              💡 Recommend Actions
            </div>

            Generate targeted actions to improve item performance.

          </div>

        </div>

      </div>

    </main>

  );

}